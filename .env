# PostgreSQL bağlantısı (docker-compose ile: postgres://ege:ege@localhost:5433/ege_yatcilik)
DATABASE_URL=postgres://ege:ege@localhost:5433/ege_yatcilik

# İlk admin kullanıcısı (db:seed ile oluşturulur)
SEED_ADMIN_EMAIL=admin@egeyatcilik.com
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=degistir-beni

# E-posta (iletişim formu bildirimleri — opsiyonel)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
